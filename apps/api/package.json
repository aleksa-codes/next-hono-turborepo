{
  "name": "api",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsup src/index.ts --watch --format esm --onSuccess 'bun run start'",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "deps": "bun x taze@latest --interactive",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^9.39.3",
    "eslint-plugin-n": "^18.2.2",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
